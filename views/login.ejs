<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Giriş - Melike Çiftçi</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main>
    <div class="login-container">
      <h1>Sadece Yetkili Personel</h1>
      <% if (error) { %>
        <div class="error-message"><%= error %></div>
      <% } %>
      <form action="/login" method="POST">
        <div class="form-group">
          <label for="username">Psikolog Adı</label>
          <input type="text" id="username" name="username" required>
        </div>
        <div class="form-group">
          <label for="password">Şifre</label>
          <input type="password" id="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Giriş</button>
      </form>
      <div style="text-align: center; margin-top: 1rem;">
        <a href="/" style="color: var(--primary-color);">← Geri dön</a>
      </div>
    </div>
  </main>
</body>
</html>
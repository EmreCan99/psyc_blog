<%- include('partials/header', { title: article.title + ' - Melike Çiftçi', isAuthenticated }) %>

<article class="article-full">
  <h1><%= article.title %></h1>
  <div class="article-meta">
    Yazan: <%= article.author %> • <%= article.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
  </div>
  <div class="article-content">
    <%= article.content %>
  </div>
  <div style="margin-top: 2rem; padding-top: 2rem; border-top: 2px solid var(--border-color);">
    <a href="/" class="btn btn-primary">← Makalelere geri dön</a>
  </div>
</article>

<%- include('partials/footer') %>